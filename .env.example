# ============================================================================
#  IFT542 — Student Registration (DELIBERATELY VULNERABLE TEACHING ARTEFACT)
#  Copy this file to `.env` for local use. Use PLACEHOLDER values only.
#  Localhost only. Never deploy. No real secrets, ever.
# ============================================================================

# Local Postgres started by docker-compose (bound to 127.0.0.1 only).
DATABASE_URL=postgres://ift542:ift542_dev_pw@127.0.0.1:5432/ift542

# Session signing secret used by the custom cookie-session auth.
#
# NOTE: In this vulnerable build the app FALLS BACK to a hardcoded secret in
# src/lib/config.ts even if this is unset — that hardcoded fallback is itself a
# planted vulnerability [VULN: Hardcoded secret — Task 3]. Set a placeholder here
# so the .env layout is documented; do not put a real secret in this repo.
SESSION_SECRET=dev-only-placeholder-not-a-real-secret

# Where uploaded documents are written on local disk (relative to project root).
UPLOAD_DIR=./uploads

# Debug flag. Left "true" on purpose in this build [VULN: Debug mode on — Task 3].
DEBUG=true
