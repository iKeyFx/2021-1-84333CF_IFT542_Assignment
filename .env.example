# ============================================================================
#  IFT542 — Student Registration
#  Copy this file to `.env` for local use. Use PLACEHOLDER values only.
#  Localhost only. Never deploy. No real secrets, ever.
# ============================================================================

# Local Postgres started by docker-compose (bound to 127.0.0.1 only).
DATABASE_URL=postgres://ift542:ift542_dev_pw@127.0.0.1:5432/ift542

# ---- Security configuration (Task 3) ---------------------------------------

# Session signing secret. Used as the HMAC key for CSRF tokens (src/lib/csrf.ts).
#
# [FIXED — Task 3] In PRODUCTION a missing value is a hard failure — that is the
# fix for the v0 hardcoded secret, and it means `npm start` will not serve
# without this file. In DEVELOPMENT it falls back to a clearly-labelled constant
# in src/lib/config.ts.
#
# That dev fallback must be a FIXED constant, not a random per-process value:
# CSRF tokens are minted in middleware (edge runtime) and verified in route
# handlers (node runtime), which are separate module instances. A random secret
# would differ between them and every token would fail. Found the hard way.
#
# Never commit a real secret.
SESSION_SECRET=dev-only-placeholder-not-a-real-secret

# Password for the seeded admin account (admin@campus.local).
#
# [FIXED — Task 3] The well-known `admin123` default is gone. If this is unset
# the seed uses the strong dummy ADMIN_PASSWORD_FALLBACK in
# db/hash-passwords.mjs, which is documented in README.md.
# ADMIN_PASSWORD=Adm1n-Str0ng-Dummy-2026-x7QF

# Comma-separated host allowlist for the admin URL-preview feature.
#
# [FIXED — Task 3] Only these hosts may be fetched. Loopback, RFC1918 private
# ranges and link-local/cloud-metadata addresses are rejected regardless of
# what appears here (src/lib/url-guard.ts).
URL_PREVIEW_ALLOWLIST=example.com,www.example.com

# Set to "false" ONLY if your browser refuses Secure cookies over
# http://127.0.0.1. Chrome and Firefox treat loopback as a trustworthy origin,
# so the default (Secure on) should work. Never disable outside local dev.
# COOKIE_SECURE=true

# Minimum level emitted by the structured security logger: info | warn | error.
LOG_LEVEL=info

# Debug flag.
# [FIXED — Task 3] Now opt-IN: only the exact string "true" enables it, so a
# typo or a missing value fails safe. It no longer causes stack traces to be
# returned to any client — it only adds server-side log detail.
DEBUG=false

# ---- Storage ---------------------------------------------------------------

# Where uploaded documents are written on local disk (relative to project root).
UPLOAD_DIR=./uploads
